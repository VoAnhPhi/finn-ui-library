{
  "name": "@finn-ui/react",
  "version": "0.0.0",
  "private": true,
  "description": "React component package foundation for Finn UI.",
  "license": "UNLICENSED",
  "homepage": "https://storybook-static-eta-ten.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/VoAnhPhi/finn-ui-library.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/VoAnhPhi/finn-ui-library/issues"
  },
  "keywords": [
    "react",
    "components",
    "ui-library",
    "theme",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external react",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@finn-ui/theme": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "latest",
    "react": "latest",
    "tsup": "latest",
    "typescript": "latest"
  }
}
