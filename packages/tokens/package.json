{
  "name": "@finn-ui/tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Design token foundation for Finn UI.",
  "license": "UNLICENSED",
  "homepage": "https://storybook-static-eta-ten.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/VoAnhPhi/finn-ui-library.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/VoAnhPhi/finn-ui-library/issues"
  },
  "keywords": [
    "design-tokens",
    "ui-library",
    "theme",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "latest",
    "typescript": "latest"
  }
}
